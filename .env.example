# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=trip_ticket
POSTGRES_PASSWORD=trip_ticket_pw
POSTGRES_DB=trip_ticket_db

# --- Prisma connection string ---
# Inside Docker, host is the service name "postgres".
# If you run the API outside Docker, change host to "localhost".
DATABASE_URL="postgresql://trip_ticket:trip_ticket_pw@postgres:5432/trip_ticket_db?schema=public"

# --- App ---
PORT=4000
NODE_ENV=development

# --- JWT ---
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
