generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  ADMIN
  HEAD_DRIVER // a driver who can ALSO approve trips (only one at a time)
  DRIVER
  FACULTY // also covers "Visiting Lecturer" — same role, just a label
  STAFF
  SSG_PRESIDENT
}

enum VehicleStatus {
  ACTIVE // available for use
  ON_TRIP
  MAINTENANCE
  INACTIVE // retired / not in service
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY // set by Admin only
}

enum TripRequestStatus {
  PENDING              // just submitted by requester
  ADMIN_APPROVED       // Admin approved, waiting for Head Driver
  HEAD_DRIVER_APPROVED // waiting for the assigned driver to Accept/Decline
                       // (Head Driver step is skipped when he is the assigned driver)
  DRIVER_ACCEPTED      // driver accepted, waiting for departure
  DRIVER_DECLINED      // driver declined, waiting for Head Driver to pick a new driver
  REJECTED             // rejected by Admin or Head Driver — see rejectedBy/At/Reason
  ONGOING              // departure log has been recorded
  COMPLETED            // return log has been recorded
}

// How the driver serves the trip — decides how busy windows are calculated.
enum ServiceMode {
  WAIT            // driver stays with passengers: busy from departure to return
  DROP_AND_PICKUP // driver drops off, returns to base, comes back at pickupTime
}

enum StopType {
  ORIGIN
  STOP
  DESTINATION
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  fullName   String
  phone      String?
  avatarUrl  String?
  role       Role
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isApproved Boolean  @default(true) // Drivers start false until Admin approves; every other role is true immediately

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Driver-specific data lives in its own table (see DriverProfile) so this
  // model stays relevant to every role, not just drivers.
  driverProfile DriverProfile?

  requestedTrips TripRequest[] @relation("Requester")
  driverTrips    TripRequest[] @relation("DriverTrips")

  vehicleAssignments VehicleAssignment[] @relation("VehicleAssignments")

  adminApprovals      TripRequest[] @relation("AdminApprovals")
  headDriverApprovals TripRequest[] @relation("HeadDriverApprovals")
  rejectedTrips       TripRequest[] @relation("RejectedTrips")

  driverDeclines TripDriverDecline[] @relation("DriverDeclines")

  ratingsGiven    Rating[] @relation("RatingsGiven")
  ratingsReceived Rating[] @relation("RatingsReceived")

  notifications       Notification[]
  refreshTokenRecords RefreshToken[]

  evaluationsGiven    TrainingRecord[] @relation("InstructorEvaluations")
  evaluationsReceived TrainingRecord[] @relation("DriverEvaluations")

  settingsUpdated SystemSettings[] @relation("SettingsUpdatedBy")

  @@index([role])
  @@index([departmentId])
  @@map("users")
}

// Driver-only data, kept separate from User to avoid null-heavy columns
// on every other role. One row per user with role = DRIVER or HEAD_DRIVER.
model DriverProfile {
  id            String       @id @default(uuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  driverCode    String       @unique // e.g. "DRV-2024-012"
  status        DriverStatus @default(AVAILABLE)
  licenseNumber String?
  dateHired     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  employeeId    String?      @unique   // e.g. "EMP-2019-0042", set by Admin
  incidentCount Int          @default(0)
  
  @@index([status])
  @@map("driver_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Fixed list of departments (CCS, CTED, High School, SCIE, CBA, CAF-SOE, etc.)
// managed as data, not free text, so requests and analytics stay consistent.
model Department {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "College of Computer Studies"
  code      String   @unique // e.g. "CCS"
  createdAt DateTime @default(now())

  users        User[]
  tripRequests TripRequest[]

  @@map("departments")
}

// Admin-managed list of destinations with a fixed one-way travel time
// from base (Katipunan). Used to calculate a driver's busy windows.
model Location {
  id            String   @id @default(uuid())
  name          String   @unique // e.g. "Dapitan", "Ipil"
  travelMinutes Int // one-way travel time from Katipunan, in minutes
  isActive      Boolean  @default(true) // hide from dropdowns without deleting
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Reserved for the future GPS feature (geofencing). Unused for now.
  latitude     Float?
  longitude    Float?
  radiusMeters Int?

  stops TripStop[]

  @@map("locations")
}

model Vehicle {
  id              String        @id @default(uuid())
  model           String
  plateNumber     String        @unique
  type            String // e.g. "Bus", "Van", "Sedan"
  capacity        Int
  year            Int?
  fuelType        String? // e.g. "Diesel", "Gasoline"
  odometerCurrent Int?
  imageUrl        String?
  status          VehicleStatus @default(ACTIVE)

  // Informational only — the vehicle's usual driver. Trip booking does NOT
  // use this: any driver may be assigned to any vehicle.
  assignments VehicleAssignment[]
  tripRequests TripRequest[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@map("vehicles")
}

// A vehicle may be assigned to many drivers, and a driver to many vehicles.
// Replaces the old one-to-one Vehicle.driverId.
//
// This is informational: trip booking still allows ANY driver on ANY
// vehicle. It records who usually drives what.
model VehicleAssignment {
  id        String  @id @default(uuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  driverId  String
  driver    User    @relation("VehicleAssignments", fields: [driverId], references: [id], onDelete: Cascade)

  // Exactly one assignment per vehicle may be primary. Enforced in the
  // service, not the database — Postgres can't express "at most one true
  // per group" without a partial unique index.
  isPrimary Boolean @default(false)

  assignedAt DateTime @default(now())

  // One row per vehicle+driver pair; assigning twice is a no-op, not a
  // duplicate.
  @@unique([vehicleId, driverId])
  @@index([driverId])
  @@map("vehicle_assignments")
}


// The core "Trip Ticket" — one requester booking an entire vehicle + driver
// for a trip, carried through the full approval → dispatch → completion flow.
model TripRequest {
  id           String @id @default(uuid())
  ticketNumber String @unique // e.g. "TT-2026-0001"

  requesterId String
  requester   User   @relation("Requester", fields: [requesterId], references: [id])

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  purpose       String
  date          DateTime
  departureTime DateTime

  // WAIT mode: returnTime is required (checked in trip.service.js).
  // DROP_AND_PICKUP mode: pickupTime is required instead.
  // Kept nullable in the DB so old trips don't break.
  serviceMode ServiceMode @default(WAIT)
  returnTime  DateTime?
  pickupTime  DateTime?

  // Upload step rule (checked in trip.service.js):
  // authorizationLetterUrl is required UNLESS isUrgent = true with an urgentReason.
  isUrgent               Boolean @default(false)
  urgentReason           String?
  authorizationLetterUrl String? // uploaded file (PDF/JPG/PNG/DOCX), path/URL stored here

  driverId String
  driver   User   @relation("DriverTrips", fields: [driverId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  certifyOfficialBusiness Boolean @default(false)
  certifyStatementCorrect Boolean @default(false)

  status TripRequestStatus @default(PENDING)

  adminApprovedById String?
  adminApprovedBy   User?     @relation("AdminApprovals", fields: [adminApprovedById], references: [id])
  adminApprovedAt   DateTime?

  // Stays null when the Head Driver step was skipped (he is the assigned driver).
  headDriverApprovedById String?
  headDriverApprovedBy   User?     @relation("HeadDriverApprovals", fields: [headDriverApprovedById], references: [id])
  headDriverApprovedAt   DateTime?

  driverAcceptedAt DateTime?

  // Used for rejection by either Admin or Head Driver.
  rejectedById   String?
  rejectedBy     User?     @relation("RejectedTrips", fields: [rejectedById], references: [id])
  rejectedAt     DateTime?
  rejectedReason String?

  printedAt DateTime? // FIRST time the ticket was printed — never overwritten

  passengers     TripPassenger[]
  stops          TripStop[]
  driverDeclines TripDriverDecline[]
  departure      TripDeparture?
  arrival        TripReturn?
  rating         Rating?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([driverId, status]) // overlap check
  @@index([vehicleId, status]) // overlap check
  @@index([departmentId])
  @@index([date])
  @@index([departureTime]) // overlap check
  @@map("trip_requests")
}

// History of drivers who declined a trip. Also used to hide them
// from the Head Driver's replacement-driver list for that trip.
model TripDriverDecline {
  id            String      @id @default(uuid())
  tripRequestId String
  tripRequest   TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)

  driverId String
  driver   User   @relation("DriverDeclines", fields: [driverId], references: [id])

  reason     String
  declinedAt DateTime @default(now())

  @@unique([tripRequestId, driverId]) // a driver can decline the same trip only once
  @@index([driverId])
  @@map("trip_driver_declines")
}

// Passenger names entered on the request — not necessarily app users.
model TripPassenger {
  id            String      @id @default(uuid())
  tripRequestId String
  tripRequest   TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)
  name          String

  @@index([tripRequestId])
  @@map("trip_passengers")
}

// Origin / destination / extra stops, in order.
model TripStop {
  id            String      @id @default(uuid())
  tripRequestId String
  tripRequest   TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)
  type          StopType
  address       String // display text (copy of Location.name when a location is picked)
  order         Int // 0 = origin, then stops in sequence, last = destination

  // Picked from the Admin-managed list. Null when the requester chose "Other".
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // SNAPSHOT of the one-way travel time used for this trip, in minutes:
  // copied from Location when picked, or typed by the requester for "Other".
  // Stored so editing a Location later never changes the busy windows of
  // trips that were already approved. Always 0 for the ORIGIN (base).
  travelMinutes Int @default(0)

  @@index([tripRequestId])
  @@index([locationId])
  @@map("trip_stops")
}

// Recorded once, when the vehicle leaves the garage.
model TripDeparture {
  id            String      @id @default(uuid())
  tripRequestId String      @unique
  tripRequest   TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)

  departureTime DateTime
  odometerStart Int

  fuelBalanceInTank    Float // liters already in tank
  fuelIssuedByOffice   Float // liters issued by the office
  fuelPurchasedDuring  Float // liters purchased during trip prep
  totalAvailableLiters Float // sum of the three above, kept explicit for easy display

  recordedAt DateTime @default(now())

  @@map("trip_departures")
}

// Recorded once, when the vehicle returns.
model TripReturn {
  id            String      @id @default(uuid())
  tripRequestId String      @unique
  tripRequest   TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)

  arrivalTime         DateTime
  odometerEnd         Int
  distanceTraveledKm  Float
  gasolineUsedLiters  Float
  balanceInTankLiters Float

  // Items 2 and 3 of the printed trip ticket. In WAIT mode these are the
  // arrival at and departure from the destination; in DROP_AND_PICKUP mode
  // they are the drop-off and the pick-up. Nullable so older trips stay valid.
  arrivedAtDestination    DateTime?
  departedFromDestination DateTime?

  gearOilUsedLiters        Float?
  lubricatingOilUsedLiters Float?
  greaseIssuedLiters       Float?

  remarks    String?
  recordedAt DateTime @default(now())

  @@map("trip_returns")
}

// Requester rates the driver after the trip is COMPLETED.
// comment = the requester's written feedback message.
model Rating {
  id            String      @id @default(uuid())
  tripRequestId String      @unique
  tripRequest   TripRequest @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)

  raterId String
  rater   User   @relation("RatingsGiven", fields: [raterId], references: [id])

  ratedUserId String
  ratedUser   User   @relation("RatingsReceived", fields: [ratedUserId], references: [id])

  score   Int // 1–5
  comment String?

  createdAt DateTime @default(now())

  @@index([ratedUserId])
  @@map("ratings")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// System-wide notification rules, set from Admin > Settings.
// Single-row table (not per-user) since these control platform behavior,
// e.g. "notify driver when assigned" affects every driver, not just one admin.
model SystemSettings {
  id                                 String  @id @default(uuid())
  notifyRequesterOnApprovalRejection Boolean @default(true)
  notifyDriverWhenAssigned           Boolean @default(true)
  sendTripCompletionReminder         Boolean @default(true)
  alertAdminOnOverdueIncompleteTrips Boolean @default(true)

  // Printed on the trip ticket's "Approved:" line. Editable by the Admin so
  // it keeps working when the GSO head changes.
  approverName  String?
  approverTitle String? @default("Administrative Officer V/GSO Unit Head")

  updatedById String?
  updatedBy   User?    @relation("SettingsUpdatedBy", fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// Instructor evaluates/trains drivers — kept from the earlier draft.
// Role no longer includes INSTRUCTOR; revisit if/when this workflow returns.
model TrainingRecord {
  id             String   @id @default(uuid())
  driverId       String
  driver         User     @relation("DriverEvaluations", fields: [driverId], references: [id])
  instructorId   String
  instructor     User     @relation("InstructorEvaluations", fields: [instructorId], references: [id])
  evaluationDate DateTime @default(now())
  score          Int? // e.g. 0-100
  notes          String?
  createdAt      DateTime @default(now())

  @@map("training_records")
}
